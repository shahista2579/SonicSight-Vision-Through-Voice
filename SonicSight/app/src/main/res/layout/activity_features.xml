<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".Features">

    <!-- Flow container -->
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="item_calculator,item_weather,item_navigation,item_location,item_battery,item_time,item_message,item_music,item_translate,item_currency,item_back,item_exit"
        app:flow_horizontalGap="12dp"
        app:flow_maxElementsWrap="3"
        app:flow_verticalGap="12dp"
        app:flow_wrapMode="chain"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Individual items -->

    <!-- Calculator -->
    <LinearLayout
        android:id="@+id/item_calculator"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Calculator Icon"
            android:src="@drawable/img_1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Calculator"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Weather -->
    <LinearLayout
        android:id="@+id/item_weather"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Weather Icon"
            android:src="@drawable/img_2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Weather"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Navigation -->
    <LinearLayout
        android:id="@+id/item_navigation"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Navigation Icon"
            android:src="@drawable/img_3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Navigation"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Location -->
    <LinearLayout
        android:id="@+id/item_location"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Location Icon"
            android:src="@drawable/img_4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Location"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Battery -->
    <LinearLayout
        android:id="@+id/item_battery"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Battery Icon"
            android:src="@drawable/img_5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Battery"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Time -->
    <LinearLayout
        android:id="@+id/item_time"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Time Icon"
            android:src="@drawable/img_7" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Time and Date"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Message -->
    <LinearLayout
        android:id="@+id/item_message"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Message Reader Icon"
            android:src="@drawable/img_6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Message reader"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Music -->
    <LinearLayout
        android:id="@+id/item_music"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Music Icon"
            android:src="@drawable/img_8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Music"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Translate -->
    <LinearLayout
        android:id="@+id/item_translate"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Translate Icon"
            android:src="@drawable/img_9" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Translate"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Currency -->
    <LinearLayout
        android:id="@+id/item_currency"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Currency Detection Icon"
            android:src="@drawable/img_12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Currency Detection"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Back -->
    <LinearLayout
        android:id="@+id/item_back"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Back Icon"
            android:src="@drawable/img_10" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Back"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Exit -->
    <LinearLayout
        android:id="@+id/item_exit"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="4dp"
        android:background="@drawable/rounded_backround"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Exit Icon"
            android:src="@drawable/img_11" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Exit"
            android:textAlignment="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/voiceInput"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="#94A0FDEA"
        android:text="@string/features"
        android:textColor="@color/black"
        android:textSize="17.5sp"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
